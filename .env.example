# Copiați acest fișier în ".env" și completați valorile din Supabase
# (Project Settings → API). Cheia "anon" este publică prin design;
# datele sunt protejate de Row Level Security.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
# Domeniul folosit intern pentru a transforma numele de utilizator în e-mail.
# Trebuie să fie IDENTIC cu cel folosit în scriptul create-user.
VITE_LOGIN_DOMAIN=agenda.laboratoruldeculoare.ro

# NUMAI pentru scriptul local "npm run create-user" – NU se pune niciodată pe server/web!
SUPABASE_SERVICE_ROLE_KEY=
